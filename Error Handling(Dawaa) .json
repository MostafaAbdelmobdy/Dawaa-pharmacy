    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst reservations = $('Read Reservations').all().map(i => i.json);\n\nfunction parseDate(val) {\n  if (!val) return NaN;\n  const s = String(val).trim();\n  // Normalize \"YYYY-MM-DD H:mm\" -> \"YYYY-MM-DDTHH:mm:00\"\n  const m = s.match(/^(\\d{4}-\\d{2}-\\d{2})\\s+(\\d{1,2}):(\\d{2})(?::(\\d{2}))?$/);\n  if (m) {\n    const [, date, h, min, sec = '00'] = m;\n    return new Date(`${date}T${h.padStart(2, '0')}:${min}:${sec}`).getTime();\n  }\n  return new Date(s).getTime();\n}\n\nconst expired = reservations.filter(r => {\n  const isReserved = String(r.status || '').trim().toLowerCase() === 'reserved';\n  const expTime = parseDate(r.expires_at);\n  return isReserved && !isNaN(expTime) && expTime < now;\n});\n\nreturn expired.map(r => ({ json: r }));"
      },
