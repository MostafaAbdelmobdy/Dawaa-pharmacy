    {
      "parameters": {
        "jsCode": "const err = $input.first().json;\nconst message = err.execution?.error?.message || 'Unknown error';\nconst nodeName = err.execution?.lastNodeExecuted || 'Unknown node';\nconst workflowName = err.workflow?.name || 'Unknown workflow';\nconst executionId = err.execution?.id || '';\nconst executionLink = err.execution?.url || '';\n\n// Classify error type, severity, and suggested fix\nlet type = 'General Error';\nlet severity = 'warning';\nlet suggestedFix = 'Inspect the execution link and node input/output data.';\n\nif (/401|403|auth|token|unauthorized|forbidden/i.test(message)) {\n  type = 'Auth Error';\n  severity = 'critical';\n  suggestedFix = 'Check API credentials, OAuth tokens, or permissions for this node.';\n} else if (/429|rate limit|quota/i.test(message)) {\n  type = 'Rate Limit';\n  severity = 'warning';\n  suggestedFix = 'Add a Wait node or enable Retry On Fail with backoff.';\n} else if (/timeout|ETIMEDOUT|ECONNRESET|502|503|504/i.test(message)) {\n  type = 'Network / Timeout';\n  severity = 'critical';\n  suggestedFix = 'External service is slow or down. Enable Retry On Fail.';\n} else if (/500|database|postgres|supabase|sheet/i.test(message)) {\n  type = 'System / DB Error';\n  severity = 'critical';\n  suggestedFix = 'Verify database/sheet connection and payload format.';\n} else if (/undefined|null|JSON|parse|syntax/i.test(message)) {\n  type = 'Data / Parsing Error';\n  severity = 'warning';\n  suggestedFix = 'Check upstream node output for missing fields or invalid JSON.';\n}\n\nconst fingerprint = `${workflowName}|${nodeName}|${type}`.toLowerCase().replace(/\\s+/g, '_');\nconst epochMinute = Math.floor(Date.now() / 60000);\n\nreturn [{\n  json: {\n    timestamp: new Date().toISOString(),\n    workflow: workflowName,\n    node: nodeName,\n    type,\n    severity,\n    message,\n    suggested_fix: suggestedFix,\n    execution_id: executionId,\n    execution_link: executionLink,\n    fingerprint,\n    epoch_minute: epochMinute,\n    alerted: 'yes',\n    status: 'open'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
