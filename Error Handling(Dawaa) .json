    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\n\nconst lowStock = items.filter(item => {\n  const stock = Number(item.stock ?? 0);\n  const reorderLevel = Number(item.reorder_level ?? 0);\n  return !isNaN(stock) && !isNaN(reorderLevel) && stock <= reorderLevel;\n});\n\n// Stop the workflow if nothing needs reordering\nif (lowStock.length === 0) return [];\n\nconst lines = lowStock.map(i =>\n  `- ${i.name} (${i.sku}): ${i.stock} left (reorder at ${i.reorder_level})`\n);\n\nconst today = new Date().toISOString().slice(0, 10);\n\nreturn [{\n  json: {\n    date: today,\n    count: lowStock.length,\n    telegram_text: `📦 *Daily Reorder List (${today})*\\n\\n${lines.join('\\n')}`,\n    email_subject: `[Reorder Required] ${lowStock.length} Low Stock Items — ${today}`,\n    email_body: `The following ${lowStock.length} items are at or below their reorder level:\\n\\n${lines.join('\\n')}`\n  }\n}];"
      },
