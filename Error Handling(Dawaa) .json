    {
      "parameters": {
        "jsCode": "const now = Date.now();\nconst reservations = $('Read Reservations').all().map(i => i.json);\nconst catalog = $('Read Catalog').all().map(i => i.json);\n\n// Sum quantities of expired reservations by SKU\nconst toRestock = {};\nfor (const r of reservations) {\n  const isPending = String(r.status || '').toLowerCase() === 'pending';\n  const expTime = new Date(r.expires_at).getTime();\n  if (isPending && !isNaN(expTime) && expTime < now) {\n    const sku = r.sku;\n    toRestock[sku] = (toRestock[sku] || 0) + Number(r.qty || 0);\n  }\n}\n\n// Calculate new stock totals against the Catalog\nconst updates = [];\nfor (const [sku, addQty] of Object.entries(toRestock)) {\n  const item = catalog.find(c => c.sku === sku);\n  if (item) {\n    updates.push({\n      json: {\n        sku,\n        new_stock: Number(item.stock || 0) + addQty\n      }\n    });\n  }\n}\n\nreturn updates;"
      },
